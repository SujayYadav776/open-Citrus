{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Citrus",
  "mainBinaryName": "citrus",
  "version": "1.2.4",
  "identifier": "com.citrus.converter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Citrus",
        "width": 460,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "category": "Utility",
    "shortDescription": "File converter with a floating radial wheel",
    "longDescription": "Citrus converts files locally (images, audio, video, documents, PDF, spreadsheets, subtitles and archives) from a radial wheel that appears next to the cursor, and offers tools such as compress, trim, rotate and resize. It uses ffmpeg, ImageMagick, pandoc, LibreOffice, poppler and ghostscript.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../LICENSE",
      "../NOTICE",
      "../AUTHORS"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/citrus/install-nautilus.sh": "../packaging/install-nautilus.sh",
          "/usr/share/citrus/install-nemo.sh": "../packaging/install-nemo.sh",
          "/usr/share/citrus/nautilus/citrus-script": "../packaging/nautilus/citrus-script"
        },
        "recommends": [
          "ffmpeg",
          "imagemagick",
          "librsvg2-bin",
          "pandoc",
          "libreoffice",
          "poppler-utils",
          "ghostscript",
          "zip",
          "unzip",
          "7zip | p7zip-full"
        ]
      }
    }
  }
}
